{
  "name": "dreep-mcp",
  "version": "0.2.0",
  "description": "The official Dreep MCP server: let any AI agent upload, transform, convert, OCR and deliver media.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dreep-mcp": "dist/bin.js"
  },
  "files": [
    "dist",
    "contract",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "node --test build/test/*.test.js",
    "test:coverage": "npm run pretest && node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-include=build/src/** --test-coverage-exclude=build/src/bin.js build/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "dreep": "^0.2.0",
    "mime-types": "^3.0.2"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "dreep",
    "mcp",
    "model-context-protocol",
    "ai",
    "agents",
    "media"
  ],
  "homepage": "https://github.com/IndigoSoftwares21/dreep-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IndigoSoftwares21/dreep-mcp.git",
    "directory": "npm"
  },
  "bugs": {
    "url": "https://github.com/IndigoSoftwares21/dreep-mcp/issues"
  }
}
